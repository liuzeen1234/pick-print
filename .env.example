# 复制本文件为 .env.local 并填入真实值。.env.local 不会被提交到 git。
# 仅 NEXT_PUBLIC_ 前缀的变量会暴露到浏览器端，其余只在服务端可用。

# 站点基础地址（用于 metadata、绝对 URL 拼接）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 服务端 API 地址示例（不会暴露到前端）
API_BASE_URL=https://api.example.com

# 数据库连接串（Vercel Postgres / Neon）。本地开发可指向本地 Postgres。
DATABASE_URL=postgresql://user:password@host:5432/pickprint

# Auth.js v5 会话加密密钥。生成：npx auth secret 或 openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-32-byte-secret
# 部署到 Vercel 之外时可显式设置站点地址（本地无需设置）
# AUTH_URL=http://localhost:3000
